{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shibshib",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "97876776-e0ed-45dc-a9b6-4e5651f3a5e1","database_name": "shibshib" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "4000c7f47c994c9f90fb858c05b9e421" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
